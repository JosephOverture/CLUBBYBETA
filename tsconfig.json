{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true, "esModuleInterop": true,
    "experimentalDecorators": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["node", "vitest/globals"], "noEmit": true
  },
  "include": ["apps/api/**/*.ts", "apps/worker/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
